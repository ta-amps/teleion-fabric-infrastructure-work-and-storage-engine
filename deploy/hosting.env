# Settings for deploy/bootstrap-hosting.sh. KEY=value lines; names only, never a secret value.
APP=tessera-fabric
VOLUME=tessera_data
VOLUME_GB=1
FLY_ORG=personal
FLY_REGION=iad
# The edge secret's name on Fly; the Worker always calls it EDGE_SECRET.
EDGE_SECRET_NAME=TESSERA_EDGE_SECRET
EDGE_CONFIG=deploy/cloudflare/wrangler.jsonc
# Secrets typed with hidden input, space-separated (none for Tessera: worker keys are minted on the machine).
PROMPT_SECRETS=
# Optional: subdomain under the shared single domain in Cloudflare (for example tessera.<your-domain>).
CUSTOM_DOMAIN=
HEALTH_URL=https://tessera.<your-subdomain>.workers.dev/v1/health
GITHUB_REPO=ta-amps/tessera
