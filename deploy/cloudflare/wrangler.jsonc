// Tessera Cloud Worker: 24/7 persistent atomic work queue, queryable CAS noun stores,
// and versioned named file buckets backed by SQLite Durable Objects (`TesseraCoordinator`)
// and Cloudflare D1 (`ta-amps-fabric` + `ta-amps-buckets`), with optional `STORAGE_MODE=origin`
// reverse-proxy fallback for Fly.io deployments.
// Deploy:
//   npx wrangler@4.154.0 deploy --config deploy/cloudflare/wrangler.jsonc
// Secrets:
//   npx wrangler@4.154.0 secret put BOOTSTRAP_SECRET --config deploy/cloudflare/wrangler.jsonc
{
  "name": "tessera",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "COORDINATOR",
        "class_name": "TesseraCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TesseraCoordinator"]
    }
  ],
  "d1_databases": [
    {
      "binding": "FABRIC_DB",
      "database_name": "ta-amps-fabric",
      "database_id": "bc3deb8e-1841-4df3-8fd5-e70f800835d1"
    },
    {
      "binding": "BUCKETS_DB",
      "database_name": "ta-amps-buckets",
      "database_id": "3fee6f31-2bd3-4bd8-9a74-95f5069a0a5b"
    }
  ],
  // Uncomment to attach a subdomain under your shared single domain in Cloudflare:
  // "routes": [{ "pattern": "tessera.<your-domain>", "custom_domain": true }],
  "vars": {
    "STORAGE_MODE": "cloud",
    "ANONYMOUS_ACCESS_ENABLED": "true",
    "REQUESTER_SIGNUP_ENABLED": "true",
    "FRAGILITY_PLANNER_ENABLED": "false",
    "PUBLIC_URL": "https://tessera.ta-amps.workers.dev",
    "REPO_URL": "https://github.com/ta-amps/tessera-infrastructure-work-and-storage-engine",
    "ORIGIN": "https://tessera-fabric.fly.dev"
  },
  "triggers": {
    "crons": ["0 */6 * * *"]
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
