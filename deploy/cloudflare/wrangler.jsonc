// Tessera edge on Cloudflare Workers: a reverse proxy in front of the Tessera service on Fly.io.
// Deploy only with Taylor's approval, through the GitHub `deploy` workflow (part `edge`) or by hand:
//   npx wrangler@4.149.0 deploy --config deploy/cloudflare/wrangler.jsonc
// EDGE_SECRET is a secret, never a var: `npx wrangler@4.149.0 secret put EDGE_SECRET --config deploy/cloudflare/wrangler.jsonc`
// (the bootstrap script in hackathon-context sets it to the same value as TESSERA_EDGE_SECRET on Fly).
{
  "name": "tessera",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "vars": {
    // Change this if the Fly app name in deploy/fly/fly.toml changes.
    "ORIGIN": "https://tessera-fabric.fly.dev"
  },
  "observability": {
    "enabled": true
  }
}
