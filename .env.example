# Names only. Copy to .env (gitignored) and fill in values yourself; agents never read .env.

# Local database for the CLI and the in-process store
TESSERA_DB=.tessera/tessera.db

# The HTTP service under test (briefs L6 to L24), and its test keys as JSON:
# {"admin": "...", "q_a": "...", "q_b": "..."}
TESSERA_URL=
TESSERA_TEST_KEYS=

# Meta Model API, used only by whoever runs the model-job lane (never by the store itself)
MODEL_API_KEY=

# Optional Baseten & Fireworks AI inference endpoints for worker harnesses (never used by the store itself)
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026
FIREWORKS_API_KEY=
